# Supabase (public keys — safe to expose in client)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# GitHub Personal Access Token — server-side only, NEVER expose to client
# Required for the GitHub GraphQL API (contribution calendar + repo count)
# Generate at: https://github.com/settings/tokens
# Scopes required: NONE (public data only — leave all checkboxes unchecked)
GITHUB_TOKEN=ghp_your_token_here
